# Gemma-Quest Environment Configuration
# Copy this file to .env and configure the values as needed.

# LLM Cloud API Key (Required for AI Studio when llm.mode is 'cloud', or for cloud provider in 'hybrid' mode)
GEMMA_API_KEY=your_api_key_here

# Optional: Cloud Endpoint Override (e.g. for Google Vertex AI, Together AI, or custom proxy)
GEMMA_CLOUD_ENDPOINT=

# Google Cloud Vertex AI Configuration (Uses Application Default Credentials - ADC automatically)
# Run `gcloud auth application-default login` to authenticate without an API key
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Optional: path to Service Account JSON key (if not using gcloud auth login)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Visualizer TUI settings
GEMMA_VISUALS_ENABLED=true
