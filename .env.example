# Gemma-Quest Environment Configuration
# Copy this file to .env and configure the values as needed.

# LLM Cloud API Key (Required when llm.mode is 'cloud', or for cloud provider in 'hybrid' mode)
GEMMA_API_KEY=your_api_key_here

# Optional: Cloud Endpoint Override (e.g. for Google Vertex AI, Together AI, or custom proxy)
GEMMA_CLOUD_ENDPOINT=
